# Copy to .env and fill in. ./scripts/ensure-local-env.sh does the copy and
# generates empty object-store keys.

# Real LLM key. The server also accepts AM_LLM_KEY.
OPENAI_API_KEY=

# LLM adapter. chat = Chat Completions (default); responses = Responses API.
AM_LLM_API=chat
# OpenAI-compatible host root. With or without a trailing /v1; both work.
# Examples: https://api.openai.com  or  https://api.openai.com/v1
AM_LLM_BASE=https://api.openai.com
# AM_LLM_TEMPERATURE=none  # unset sends temperature 0; none omits the field
AM_DEFAULT_MODEL=gpt-4o-mini
# HTML visual style when create omits style: house, bold, editorial, playful, terminal, or swiss.
AM_DEFAULT_STYLE=house
# First HTML build. full: the model writes HTML. fast: the model writes Markdown and the server renders it.
AM_BUILD_MODE=full
# Styles that default to fast when create omits mode. Empty keeps AM_BUILD_MODE for every style.
# A complete HTML source, or a request to publish that HTML as-is, stays full when mode is omitted.
# Example: AM_FAST_STYLES=house
AM_FAST_STYLES=

# Share lifetime: 0 = until revoked; positive = days, capped by AM_SHARE_TTL_MAX_DAYS.
AM_SHARE_TTL_DAYS=30
AM_SHARE_TTL_MAX_DAYS=365

# Object store (S3-compatible). Leave the keys empty and run
# ./scripts/ensure-local-env.sh, or paste your own values.
AM_STORE_ENDPOINT=http://storage:9000
AM_STORE_BUCKET=artifacts
AM_STORE_KEY=
AM_STORE_SECRET=

# In-container listen address. Compose defaults this to 0.0.0.0; plain `serve` defaults to 127.0.0.1.
# AM_HOST=0.0.0.0

# Host publish bind for API (8780) and preview/share (8781). Default is loopback-only.
# Use 0.0.0.0 or a specific interface IP to reach the ports from another machine.
AM_BIND_ADDRESS=127.0.0.1

# URLs written into cards, preview links, and share links. When you change
# AM_BIND_ADDRESS or put a reverse proxy in front, set these to the address
# clients will actually open (otherwise links keep pointing at 127.0.0.1).
AM_API_URL=http://127.0.0.1:8780
AM_PREVIEW_URL=http://127.0.0.1:8781
# Defaults to AM_PREVIEW_URL when empty.
AM_SHARE_URL=

# Output policy.
AM_BLOCK_PRIVATE_LINKS=true
AM_ALLOWED_LINK_DOMAINS=

# MCP Host/Origin allow-lists (comma-separated). DNS-rebinding protection is on by
# default for 127.0.0.1/localhost on the API port when AM_ALLOWED_HOSTS is unset.
AM_ALLOWED_HOSTS=127.0.0.1:8780,localhost:8780
AM_ALLOWED_ORIGINS=

# My pages (/app/) session cookie. Unset follows AM_API_URL (Secure only for https).
# Set true behind TLS, or false for the local HTTP quickstart.
AM_COOKIE_SECURE=

# Reverse proxies allowed to name the browser for My pages login limits.
# Comma-separated IPs or CIDRs. Empty ignores X-Real-IP and X-Forwarded-For.
# SWAG on this network: AM_TRUSTED_PROXIES=192.168.30.160
AM_TRUSTED_PROXIES=
AM_LOGIN_LIMIT=8
AM_LOGIN_PREFIX_LIMIT=8
AM_LOGIN_WINDOW_S=900

# Hosted trial. Off until you set AM_TRIAL_ENABLED=true. Point AM_API_URL at the public origin.
# AM_TRIAL_ENABLED=false
# AM_TRIAL_EMAIL_VERIFY=true
# AM_TRIAL_BUILD_LIMIT=20
# AM_TRIAL_BUILDS_PER_HOUR=10
# AM_TRIAL_DAILY_USD=10
# AM_TRIAL_PRICE_IN=0.10
# AM_TRIAL_PRICE_OUT=0.50
# AM_TRIAL_MODEL=anthropic/claude-haiku-5-5
# AM_TRIAL_MAX_OUTPUT_TOKENS=16000
# AM_TRIAL_SIGNUPS_PER_IP=3
# AM_TRIAL_SIGNUP_WINDOW_S=86400
# AM_TRIAL_LINK_TTL_S=1800
# AM_TRIAL_RETENTION_DAYS=30
# AM_TRIAL_ABUSE_EMAIL=
# AM_SMTP_HOST=
# AM_SMTP_PORT=587
# AM_SMTP_USER=
# AM_SMTP_PASSWORD=
# AM_SMTP_FROM=
# AM_SMTP_TLS=true

# Every setting above also has a NAME_FILE variant (e.g. AM_STORE_SECRET_FILE=/run/secrets/store_secret)
# so a value can be read from a file instead of the environment.
