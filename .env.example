# Copy to .env and fill in. Only the values you set here override the compose defaults.

# Real LLM key (leave empty under the compose 'test' profile — mock-llm needs no key).
OPENAI_API_KEY=

# LLM adapter. chat = Chat Completions (default); responses = Responses API.
AM_LLM_API=chat
# Default provider host. Point at your own gateway in production.
AM_LLM_BASE=https://api.openai.com
AM_DEFAULT_MODEL=gpt-4o-mini

# Share lifetime: 0 = until revoked; positive = days, capped by AM_SHARE_TTL_MAX_DAYS.
AM_SHARE_TTL_DAYS=30
AM_SHARE_TTL_MAX_DAYS=365

# Object store (S3-compatible). compose already wires these to the internal rustfs.
AM_STORE_ENDPOINT=http://storage:9000
AM_STORE_BUCKET=artifacts
AM_STORE_KEY=am-local-access-key
AM_STORE_SECRET=am-local-secret-key-not-the-default-pair

# Output policy.
AM_BLOCK_PRIVATE_LINKS=true
AM_ALLOWED_LINK_DOMAINS=

# Every setting above also has a NAME_FILE variant (e.g. AM_STORE_SECRET_FILE=/run/secrets/store_secret)
# so a value can be read from a file instead of the environment.
